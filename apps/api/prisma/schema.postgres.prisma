generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  LOCKED
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  subdomain String?  @unique
  logoUrl   String?
  gpsConfig String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches      Branch[]
  departments   Department[]
  employees     Employee[]
  productTypes  ProductType[]
  pieceRates    PieceRate[]
  payrollRuns   PayrollRun[]
  refreshTokens RefreshToken[]
  roles         Role[]

  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  address   String?
  location  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employees Employee[]

  @@index([companyId])
  @@map("branches")
}

model Department {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @db.Uuid @map("company_id")
  company   Company      @relation(fields: [companyId], references: [id])
  name      String
  parentId  String?      @db.Uuid @map("parent_id")
  parent    Department?  @relation("DeptToDept", fields: [parentId], references: [id])
  children  Department[] @relation("DeptToDept")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  employees Employee[]

  @@index([companyId])
  @@map("departments")
}

model Employee {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  branchId String? @db.Uuid @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id])

  deptId String?       @db.Uuid @map("dept_id")
  dept   Department?   @relation(fields: [deptId], references: [id])

  code      String?
  fullName  String  @map("full_name")
  email     String?
  phone     String?
  isActive  Boolean @default(true) @map("is_active")
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User?
  productionEntries ProductionEntry[]
  allowances        EmployeeAllowance[]
  payrollLines      PayrollLine[]

  @@index([companyId])
  @@map("employees")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String?   @unique @db.Uuid @map("employee_id")
  employee     Employee? @relation(fields: [employeeId], references: [id])
  username     String   @unique
  passwordHash String   @map("password_hash")
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles         UserRole[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Role {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid @map("role_id")
  permissionId String @db.Uuid @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid @map("user_id")
  roleId String @db.Uuid @map("role_id")
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String   @db.Uuid @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model ProductType {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  unit      String  @default("pcs")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rates           PieceRate[]
  entries         ProductionEntry[]
  payrollLineItems PayrollLineItem[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("product_types")
}

model PieceRate {
  id            String      @id @default(uuid()) @db.Uuid
  companyId     String      @db.Uuid @map("company_id")
  company       Company     @relation(fields: [companyId], references: [id])
  productTypeId String      @db.Uuid @map("product_type_id")
  productType   ProductType @relation(fields: [productTypeId], references: [id])
  rateVnd       Int         @map("rate_vnd")
  effectiveFrom DateTime    @map("effective_from") @db.Date
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([companyId, productTypeId, effectiveFrom])
  @@index([companyId, productTypeId, effectiveFrom(sort: Desc)])
  @@map("piece_rates")
}

model ProductionEntry {
  id            String      @id @default(uuid()) @db.Uuid
  companyId     String      @db.Uuid @map("company_id")
  employeeId    String      @db.Uuid @map("employee_id")
  employee      Employee    @relation(fields: [employeeId], references: [id])
  productTypeId String      @db.Uuid @map("product_type_id")
  productType   ProductType @relation(fields: [productTypeId], references: [id])
  quantity      Int
  workDate      DateTime    @map("work_date") @db.Date
  evidenceUrl   String?     @map("evidence_url")
  status        EntryStatus @default(DRAFT)
  note          String?

  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz(6)
  approvedBy   String?   @db.Uuid @map("approved_by")
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectReason String?   @map("reject_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, employeeId, workDate, productTypeId])
  @@index([companyId, workDate])
  @@index([companyId, employeeId, workDate])
  @@map("production_entries")
}

model EmployeeAllowance {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid @map("company_id")
  employeeId    String   @db.Uuid @map("employee_id")
  employee      Employee @relation(fields: [employeeId], references: [id])
  name          String
  amountVnd     Int      @map("amount_vnd")
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId, employeeId, effectiveFrom])
  @@map("employee_allowances")
}

model PayrollRun {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @db.Uuid @map("company_id")
  company      Company      @relation(fields: [companyId], references: [id])
  month        Int
  year         Int
  status       PayrollStatus @default(DRAFT)
  totalAmount  Int          @default(0) @map("total_amount")
  calculatedAt DateTime?    @map("calculated_at") @db.Timestamptz(6)
  lockedAt     DateTime?    @map("locked_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  lines PayrollLine[]

  @@unique([companyId, year, month])
  @@index([companyId, year, month])
  @@map("payroll_runs")
}

model PayrollLine {
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @db.Uuid @map("company_id")
  payrollRunId String     @db.Uuid @map("payroll_run_id")
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id])
  employeeId   String     @db.Uuid @map("employee_id")
  employee     Employee   @relation(fields: [employeeId], references: [id])

  productionPay Int @default(0) @map("production_pay")
  allowancePay  Int @default(0) @map("allowance_pay")
  totalPay      Int @default(0) @map("total_pay")

  metadata  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items PayrollLineItem[]

  @@unique([companyId, payrollRunId, employeeId])
  @@index([companyId, payrollRunId])
  @@map("payroll_lines")
}

model PayrollLineItem {
  id             String     @id @default(uuid()) @db.Uuid
  companyId      String     @db.Uuid @map("company_id")
  payrollLineId  String     @db.Uuid @map("payroll_line_id")
  payrollLine    PayrollLine @relation(fields: [payrollLineId], references: [id])
  productTypeId  String     @db.Uuid @map("product_type_id")
  productType    ProductType @relation(fields: [productTypeId], references: [id])

  quantityTotal     Int      @map("quantity_total")
  rateEffectiveFrom DateTime @map("rate_effective_from") @db.Date
  rateVnd           Int      @map("rate_vnd")
  amountVnd         Int      @map("amount_vnd")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, payrollLineId])
  @@map("payroll_line_items")
}
